{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent"
  ],
  "provider": {
    "qianfan-coding-plan": {
      "name": "Baidu Qianfan CodingPlan",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://qianfan.baidubce.com/v2/coding"
      },
      "models": {
        "glm-5.1": {
          "id": "glm-5.1",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-5": {
          "id": "glm-5",
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "kimi-k2.5": {
          "id": "kimi-k2.5",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "deepseek-v3.2": {
          "id": "deepseek-v3.2",
          "limit": {
            "context": 128000,
            "output": 12800
          }
        },
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "qwen3.5-397b-a17b": {
          "id": "qwen3.5-397b-a17b",
          "limit": {
            "context": 262144,
            "output": 81920
          }
        }
      },
      "whitelist": [
        "glm-5.1",
        "glm-5",
        "kimi-k2.5",
        "deepseek-v3.2",
        "deepseek-v4-flash",
        "qwen3.5-397b-a17b"
      ]
    },
    "mimo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xiaomi MiMo",
      "options": {
        "baseURL": "https://api.xiaomimimo.com/v1",
        "apiKey": "{env:XIAOMI_MIMO_API_KEY}"
      },
      "models": {
        "mimo-v2.5-pro": {
          "id": "mimo-v2.5-pro",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      },
      "whitelist": [
        "mimo-v2.5-pro"
      ]
    }
  },
  "model": "qianfan-coding-plan/glm-5.1",
  "small_model": "qianfan-coding-plan/deepseek-v4-flash"
}
